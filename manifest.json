{
  "manifest_version": 3,
  "name": "NT Head-to-Head",
  "version": "2.3.0",
  "description": "Compare any two Nitro Type racers or teams, side by side, right from a tab inside Nitro Type itself.",
  "permissions": ["storage"],
  "action": {
    "default_title": "NT Head-to-Head (open on nitrotype.com)"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.nitrotype.com/*"],
      "js": ["lib/nt.js", "lib/seed-teams.js", "content/inject.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://www.nitrotype.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

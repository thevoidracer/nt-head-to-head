{
  "manifest_version": 3,
  "name": "NT Head-to-Head",
  "version": "1.0.0",
  "description": "Compare any two Nitro Type racers or teams, side by side, with recent-form context.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "NT Head-to-Head"
  },
  "host_permissions": [
    "https://www.nitrotype.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
